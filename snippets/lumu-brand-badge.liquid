{% comment %}
  Lumu brand badge overlay — English ↔ Urdu logo alternates every 5s.

  Accepts:
  - size: {String} 'card' or 'pdp' (default: 'pdp')
{% endcomment %}

{%- liquid
  assign badge_size = size | default: 'pdp'
  if badge_size == 'card'
    assign logo_width = 48
    assign logo_height = 16
  else
    assign logo_width = 72
    assign logo_height = 24
  endif
-%}

<div class="lumu-brand-badge lumu-brand-badge--{{ badge_size }}" aria-hidden="true">
  <div class="lumu-brand-badge__slider">
    <img
      src="{{ 'lumulogo.png' | asset_url }}"
      alt=""
      class="lumu-brand-badge__logo lumu-brand-badge__logo--en"
      width="{{ logo_width }}"
      height="{{ logo_height }}"
      loading="lazy"
    >
    <img
      src="{{ 'lumu2.png' | asset_url }}"
      alt=""
      class="lumu-brand-badge__logo lumu-brand-badge__logo--ur"
      width="{{ logo_width }}"
      height="{{ logo_height }}"
      loading="lazy"
    >
  </div>
</div>
